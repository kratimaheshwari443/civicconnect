# CivicConnect Environment Variables
# Copy this file to .env and insert your API keys

# Google Maps Platform Geocoding API Key (for Indian address verification)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Groq Cloud API Key (for LLM grievance triage, monitoring roadmap & translations)
GROQ_API_KEY=your_groq_api_key_here

# Flask Session Secret Key (for securing officer login sessions)
SECRET_KEY=civicconnect-production-secret-key-replace-in-prod
